{
	"name": "web_lic",
	"version": "0.48.0",
	"description": "Create an instruction book from a 3D model",
	"scripts": {
		"typecheck": "tsc --version && tsc -b",
		"lint": "DEBUG=eslint:eslint eslint . --report-unused-disable-directives --max-warnings 0",
		"lint-fix": "eslint . --fix",
		"start": "vite",
		"dev": "vite",
		"build": "tsc --version && tsc -b && npm run lint && vite build",
		"preview": "vite preview",
		"test": "npx cypress open",
		"deploy": "npm run build && python deploy.py"
	},
	"keywords": [],
