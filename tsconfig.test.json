{
	"compilerOptions": {
		"outDir": "./dist",
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"es2022",
			"dom"
		],
		"types": [
			"node"
		],
		"skipLibCheck": true,
		"strict": true,
		"alwaysStrict": true,
		"noImplicitReturns": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"composite": true,
		"tsBuildInfoFile": "./dist/.tsbuildinfo-test"
	},
	"include": [
		"./test/**/*"
	],
	"exclude": [
		"node_modules"
	]
}
